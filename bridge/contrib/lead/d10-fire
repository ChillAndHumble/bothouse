#!/usr/bin/env -S python3 -I
# d10 到点时由 cc-connect timer 调用：队友已交回就不发「暂停」，没交回才发。
# 用法：d10-fire <队友id> <简称> <派活epoch> <session_key> <发消息的 cc-connect project> [--dry-run]（d10 填好参数）
# 来源：用户 2026-10-23「复盘一下现在的工作流程，看看怎么样更好的就是我们并行的团队模式的去搞」；
#   事故：2026-10-23 上午 d10 计时 4 次在队友早已交回后白发「暂停」（03:46、10:39 彩虹猫，10:47 前后），
#   还打断了队友手上的下一件活。规则靠自觉管不住，改成到点自动判断。
import json, os, re, subprocess, sys, urllib.request
from datetime import datetime
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
import _team  # noqa: E402

DISCORD_EPOCH_MS = 1420070400000
STATUS_PREFIXES = ("↪", "⏹", "📬")  # gate 状态行（本任务原话）
MIN_LEN = 80                         # 短于 80 字视为状态行（本任务原话）
# 「交回」关键词与 PR 链接（本任务原话：接单消息「【接】已派子 agent」不算交回）
HANDBACK_RE = re.compile(r"交付|交回|PR|commit|已停手|做完|完成")
PR_LINK_RE = re.compile(r"github\.com/[^\s]+/pull/\d+")


def is_handback(content: str) -> bool:
    c = (content or "").strip()
    if not c or c.startswith(STATUS_PREFIXES):
        return False
    if c.startswith("【接】") and not PR_LINK_RE.search(c):
        # 接单表态里常写「做完交回」，不算交回（本任务原话「先发一条【接】……再干活，这不算交回」）
        return False
    if len(c) < MIN_LEN:
        return False
    return bool(HANDBACK_RE.search(c) or PR_LINK_RE.search(c))


def ts_epoch(m) -> float:
    return datetime.fromisoformat(m["timestamp"].replace("Z", "+00:00")).timestamp()


def handed_back(messages, teammate_id: str, since: float) -> bool:
    for m in messages:
        if str(m.get("author", {}).get("id")) != str(teammate_id):
            continue
        if ts_epoch(m) < since:
            continue
        if is_handback(m.get("content", "")):
            return True
    return False


def fetch_messages(channel_id: str, since: float):
    after = (int(since * 1000) - DISCORD_EPOCH_MS) << 22
    url = f"https://discord.com/api/v10/channels/{channel_id}/messages?limit=50&after={after}"
    req = urllib.request.Request(url, headers={
        "Authorization": f"Bot {_team.token()}",
        "User-Agent": "DiscordBot (bothouse, 1)",
    })
    with urllib.request.urlopen(req, timeout=20) as r:
        return json.load(r)


def main(argv):
    dry = "--dry-run" in argv
    args = [a for a in argv if a != "--dry-run"]
    if len(args) != 5:
        print("用法：d10-fire <队友id> <简称> <派活epoch> <session_key> <project> [--dry-run]", file=sys.stderr)
        return 2
    tid, what, since, skey, proj = args[0], args[1], float(args[2]), args[3], args[4]
    channel = skey.split(":", 1)[1] if ":" in skey else skey
    try:
        done = handed_back(fetch_messages(channel, since), tid, since)
    except Exception as e:  # 读不到频道就按原行为发暂停，不吞掉打断
        print(f"读频道失败（{type(e).__name__}），按原行为发暂停", file=sys.stderr)
        done = False
    if done:
        print("已交回，跳过暂停")
        return 0
    msg = f"<@{tid}> 暂停（「{what}」到 10 分钟了，停手，把做到哪一步交回来）"
    if dry:
        print(f"未交回，会发暂停：{msg}")
        return 0
    return subprocess.run(["cc-connect", "send", "-p", proj, "-s", skey, "--message", msg]).returncode


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
